# Chaîne de connexion PostgreSQL (Neon : utiliser l'URL "pooled", avec ?sslmode=require)
DATABASE_URL="postgresql://utilisateur:motdepasse@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# (Optionnel) Connexion directe Neon, sans "-pooler", utilisée par les migrations Prisma
# DIRECT_URL="postgresql://utilisateur:motdepasse@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Mot de passe unique pour se connecter à l'application
APP_PASSWORD="changez-moi"

# Secret de signature des cookies de session (au moins 32 caractères aléatoires)
# Générer avec : openssl rand -base64 32
SESSION_SECRET="remplacez-par-une-chaine-aleatoire-de-32-caracteres-minimum"
